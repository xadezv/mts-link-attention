{
  "rulesVersion": 2,
  "updatedAt": "2026-09-04",
  "extensionVersion": "1.1.0",
  "downloadUrl": "https://github.com/xadezv/mts-link-attention/releases/latest/download/mts-link-attention.zip",
  "notes": "Панель работает без разрешения пользовательских скриптов.",
  "modalSelectors": [
    "[class*=\"AttentionControlModal__root\"]",
    "[data-testid^=\"AttentionControlModal\"]",
    "[data-test-id^=\"AttentionControlModal\"]",
    "[data-qa^=\"AttentionControlModal\"]"
  ],
  "successSelectors": [
    "[class*=\"AttentionControlSuccessModal__root\"]"
  ],
  "timerSelectors": [
    "[class*=\"AttentionControlModal__timer\"]"
  ],
  "confirmButtonTexts": [
    "подтверждаю",
    "confirm"
  ],
  "buttonSearchDepth": 5,
  "involvementRe": "setUserInvolvementStatus",
  "confirmRe": "(checkpoint|attention|involvement.*confirm|confirm.*presence)",
  "forcedBody": "isFocused=true&isSoundEnabled=true&isVideoEnabled=true",
  "remoteScript": {
    "enabled": true,
    "version": 2,
    "url": "https://raw.githubusercontent.com/xadezv/mts-link-attention/main/remote.js",
    "sha256": "23b5d293a68e05ed9922c9a73381de2f0592a84e35f22da01be2c03137808990",
    "matches": [
      "*://*.mts-link.ru/*",
      "*://*.mts-link.com/*",
      "*://*.webinar.ru/*"
    ]
  },
  "fire": {
    "selectors": [
      "[class*=\"Reaction\"] button",
      "button[class*=\"Reaction\"]",
      "button[class*=\"Fire\"]",
      "button[class*=\"Emoji\"]",
      "button[aria-label*=\"огон\" i]",
      "button[title*=\"огон\" i]"
    ],
    "textMatches": [
      "🔥"
    ],
    "labelRe": "огон[её]к|fire|реакц"
  },
  "remoteMainScript": {
    "enabled": false,
    "version": 1,
    "url": "https://raw.githubusercontent.com/xadezv/mts-link-attention/main/remote-main.js",
    "sha256": "6048b16fb763e2ab87476ce2258f4839c3f33c3a5da6e32a7695d0d02f7eedf4",
    "matches": [
      "*://*.mts-link.ru/*",
      "*://*.mts-link.com/*",
      "*://*.webinar.ru/*"
    ]
  }
}