{
  "manifest_version": 3,
  "name": "Контроль присутствия — автоподтверждение",
  "version": "1.1.0",
  "description": "Ловит модалку «Контроль присутствия» на МТС Линк / Webinar, подтверждает её и шлёт уведомление, что нужно нажать.",
  "permissions": [
    "storage",
    "notifications",
    "offscreen",
    "alarms",
    "userScripts"
  ],
  "host_permissions": [
    "*://*.mts-link.ru/*",
    "*://*.mts-link.com/*",
    "*://*.webinar.ru/*",
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Контроль присутствия",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true,
      "js": [
        "src/inject.js"
      ],
      "matches": [
        "*://*.mts-link.ru/*",
        "*://*.mts-link.com/*",
        "*://*.webinar.ru/*"
      ]
    },
    {
      "world": "ISOLATED",
      "run_at": "document_idle",
      "all_frames": true,
      "js": [
        "src/content.js"
      ],
      "matches": [
        "*://*.mts-link.ru/*",
        "*://*.mts-link.com/*",
        "*://*.webinar.ru/*"
      ]
    }
  ]
}